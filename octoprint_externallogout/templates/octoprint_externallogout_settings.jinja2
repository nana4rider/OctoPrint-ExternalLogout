<form class="form-horizontal">
    <div class="control-group">
        <label class="control-label" for="octoprint_externallogout_url">External logout URL</label>
        <div class="controls">
            <input id="octoprint_externallogout_url" type="url" class="input-block-level" data-bind="value: settings.plugins.octoprint_externallogout.logout_url">
            <p class="help-block">When set, OctoPrint's existing Logout action ends its local session and then redirects to this URL.</p>
        </div>
    </div>
</form>
